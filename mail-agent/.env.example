# --- Mode d'envoi : true = SIMULATION (rien n'est envoyé). Passez à false seulement quand tout est vérifié.
DRY_RUN=true
PORT=5600

# --- IA : anthropic (défaut si ANTHROPIC_API_KEY est défini) | mistral | ollama (local, gratuit)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# --- Gmail (scope gmail.send uniquement). Créez un client OAuth « Application Web » dans Google Cloud,
#     redirect URI : http://localhost:5600/oauth2callback, puis lancez : node agent.js auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=

# --- Cadence et plafonds (candidature spontanée responsable)
MAX_EMAILS_PER_RUN=10
MAX_EMAILS_PER_DAY=30
EMAIL_MIN_DELAY_SECONDS=30
EMAIL_MAX_DELAY_SECONDS=90
