ENV=dev
JWT_SECRET=change-me-long-random
INTERNAL_SECRET=change-me-too
CERT_SECRET=change-me-cert
QDRANT_URL=:memory:
GMAIL_SERVICE_URL=http://localhost:3001

# Service Gmail (scope: gmail.send uniquement)
DRY_RUN=true
# Lecture seule de la boîte de réception (bouton 2 « E-mails reçus ») : nécessite le jeton Google avec le scope gmail.readonly
GMAIL_READ=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=

# Observabilité LangSmith (optionnel)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=

# Traitement IA du résumé et des « activités et responsabilités » : auto = actif si ANTHROPIC_API_KEY est défini ; false = désactivé
CV_LLM_REFINE=auto
ANTHROPIC_API_KEY=
CV_LLM_MODEL=claude-sonnet-5-5

# n8n : webhook appelé par le backend après un envoi réussi (déclenche WF-3, relance à J+7 soumise à approbation)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/application-status
FOLLOWUP_MIN_DAYS=5

# Plateforme de formation (Moodle, Web Services REST). Vide = désactivé : les cours restent des liens de fournisseurs.
MOODLE_URL=
MOODLE_TOKEN=
MOODLE_AUTO_CREATE_USERS=false
LMS_WEBHOOK_SECRET=
# LMS_COURSES_FILE=backend/lms_courses.json

# Vraies offres d'emploi (sinon seuls Arbeitnow = Allemagne et Remotive = télétravail répondent, sans clé)
ADZUNA_APP_ID=          # gratuit : https://developer.adzuna.com  (FR DE IT ES GB US NL BE CH CA AT PL AU...)
ADZUNA_APP_KEY=
FT_CLIENT_ID=           # France Travail (offres officielles France) : https://francetravail.io
FT_CLIENT_SECRET=
JOBS_DEMO=0             # 1 = affiche aussi les offres FICTIVES du catalogue de démonstration
JOBS_CACHE_TTL=900

# Connexion en production (ENV=prod) : codes d'accès « code:rôle » (10 caractères minimum, rôles : candidate, approver, admin).
# Chaque personne reçoit son propre code. Remplaçable par OIDC (Google, Microsoft, Keycloak…) quand vous aurez de vrais comptes.
ACCESS_CODES=
